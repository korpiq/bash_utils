#!/bin/bash
# Links the Remmina profile and launcher for connecting to legion9955hx.
# Run on katonkoti26.
set -euo pipefail

THIS_DIR=$(cd "$(dirname "$BASH_SOURCE")"; pwd)
SRC="$THIS_DIR/hosts/katonkoti26/home/dot.local/share"
DEST="$HOME/.local/share"

for FILE in remmina/legion.remmina applications/legion-remote.desktop
do
    mkdir -p "$DEST/$(dirname "$FILE")"
    ln -sfv "$SRC/$FILE" "$DEST/$FILE"
done

# The Remmina snap cannot read dotfiles under $HOME, so it needs its own copy.
SNAP_DIR="$HOME/snap/remmina/current/.local/share/remmina"
mkdir -p "$SNAP_DIR"
cp -v "$SRC/remmina/legion.remmina" "$SNAP_DIR/"

command -v remmina >/dev/null || echo "remmina is not installed: sudo apt install remmina remmina-plugin-rdp" >&2
