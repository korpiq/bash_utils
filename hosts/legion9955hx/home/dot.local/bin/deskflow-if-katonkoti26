#!/bin/bash
# Start Deskflow (client, per ~/.config/Deskflow) only if a Deskflow server
# answers on katonkoti26. Retries for a while since network may come up
# after login.

SERVER_IP_FILE=~/omat/kato-private-agent-rules/common-rules/host-specific/katonkoti26/ip-address-at-home.txt
SERVER=$(head -n1 "$SERVER_IP_FILE") || exit 1
PORT=24800
TRIES=${TRIES:-12}
DELAY=${DELAY:-5}

pgrep -x deskflow >/dev/null && exit 0

for ((i = 1; i <= TRIES; i++))
do
    if timeout 2 bash -c "</dev/tcp/$SERVER/$PORT" 2>/dev/null
    then
        exec setsid deskflow >/dev/null 2>&1
    fi
    [ "$i" -lt "$TRIES" ] && sleep "$DELAY"
done

echo "No Deskflow server at $SERVER:$PORT; not starting" >&2
exit 1
